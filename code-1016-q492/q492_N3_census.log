=== N=3 type C   (build 1s) ===
--- diagonal entries A_{I,I}: long-root factors (w_a w_b - 1) ---
  I=()  |I|=0   A_II = (q*w1**2 - 1)*(q*w2**2 - 1)*(q*w3**2 - 1)*(q*w1*w2 - 1)*(q*w1*w3 - 1)*(q*w2*w3 - 1)
  I=(1,)  |I|=1   A_II = -(w1 - 1)*(w1 + 1)*(q*w2 - w1)*(q*w2**2 - 1)*(q*w3 - w1)*(q*w3**2 - 1)*(q*w2*w3 - 1)/w1**4
  I=(2,)  |I|=1   A_II = -(w1 - w2)*(w2 - 1)*(w2 + 1)*(q*w1**2 - 1)*(q*w3 - w2)*(q*w3**2 - 1)*(q*w1*w3 - 1)/w2**4
  I=(3,)  |I|=1   A_II = -(w1 - w3)*(w2 - w3)*(w3 - 1)*(w3 + 1)*(q*w1**2 - 1)*(q*w2**2 - 1)*(q*w1*w2 - 1)/w3**4
  I=(1, 2)  |I|=2   A_II = -(w1 - 1)*(w1 + 1)*(w2 - 1)*(w2 + 1)*(q*w3 - w1)*(q*w3 - w2)*(q*w3**2 - 1)*(w1*w2 - 1)/(w1**4*w2**4)
  I=(1, 3)  |I|=2   A_II = -(w1 - 1)*(w1 + 1)*(w2 - w3)*(w3 - 1)*(w3 + 1)*(q*w2 - w1)*(q*w2**2 - 1)*(w1*w3 - 1)/(w1**4*w3**4)
  I=(2, 3)  |I|=2   A_II = -(w1 - w2)*(w1 - w3)*(w2 - 1)*(w2 + 1)*(w3 - 1)*(w3 + 1)*(q*w1**2 - 1)*(w2*w3 - 1)/(w2**4*w3**4)
  I=(1, 2, 3)  |I|=3   A_II = (w1 - 1)*(w1 + 1)*(w2 - 1)*(w2 + 1)*(w3 - 1)*(w3 + 1)*(w1*w2 - 1)*(w1*w3 - 1)*(w2*w3 - 1)/(w1**4*w2**4*w3**4)

